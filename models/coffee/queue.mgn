model "Queue" {

    function is_open(time) {
        hour = (time - floor(time)) * 24
        return if(hour >= open_hour, if(hour <= close_hour, 1, 0), 0)
    }

    function time_to_open_as_days(time, tolerance) {
        frac_part_time = time - floor(time)
        hour = frac_part_time * 24

        return if(
            hour >= close_hour,
            1 - frac_part_time + open_hour / 24 + tolerance,
            if(hour <= open_hour, open_hour / 24 - frac_part_time + tolerance, 0)
        )
    }

    controls {
        default {
            open_hour = 8
            close_hour = 22

            average_duration_order = 60 * 7 # s
            average_count_clients_per_1h = 15

            average_wait = 5 * 60 + 30 # s
            std_wait = 30 # s

            count_masters = 4
        }
        limits {
        }
    }

    # Свободный мастер берёт клиента из головы очереди, как только оба есть.
    event StartOrder {
        trigger {
            when idle_masters > 0 and size(clients) > 0
        }
        do {
            instant[client_id] = pop clients
            idle_masters = idle_masters - 1
            count_served = count_served + 1
        }
        emit OrderDone after normal(average_duration_order, 10) * 1s
    }

    # Заказ готов — клиент обработан, мастер свободен
    event OrderDone {
        do {
            idle_masters = idle_masters + 1
            count_processed = count_processed + 1
        }
    }

    # Терпение кончилось: если клиент ещё в очереди — уходит
    event ClientLeave(client_id) {
        do {
            instant[still_waiting] = contains(clients, client_id)
            remove clients(client_id)
            count_lost = count_lost + instant[still_waiting]
        }
    }

    event RegisterClient {
        do {
            last_client_id = last_client_id + 1
            push clients(last_client_id)
            instant[delay] = max(0, normal(average_wait, std_wait)) * 1s
        }
        emit ClientLeave(last_client_id) after instant[delay]
    }

    # Очередной приход клиента. Если кофейня открыта — клиент регистрируется;
    # следующий приход — через exponential, а если закрыто — через exponential после открытия.
    event VisitClientGenerator {
        do {
            instant[is_open] = call is_open(TIME)
            instant[is_closed] = 1 - instant[is_open]
            instant[days_to_open] = call time_to_open_as_days(TIME, 0.0001)
            instant[delay] = exponential(1/average_count_clients_per_1h) * 1h
        }
        choose {
            instant[is_open]: emit RegisterClient
                              emit VisitClientGenerator after instant[delay]
            instant[is_closed]: emit VisitClientGenerator after instant[days_to_open] * 1d + instant[delay]
        }
    }

    event _init {
        do {
            count_lost = 0
            count_served = 0       # начали обслуживать
            count_processed = 0    # заказ готов
            last_client_id = 0
            clients = queue()      # номера клиентов, ожидающих заказа
            idle_masters = count_masters   # свободные мастера
        }
        trigger {
            on start
        }
        emit VisitClientGenerator
    }
}
